# Environment Configuration for Walk-In & Online Integration

# ========== Database ==========
MONGODB_URI=mongodb://localhost:27017/restro-matrix

# ========== Server ==========
PORT=4000
NODE_ENV=development

# ========== JWT Authentication ==========
JWT_SECRET=your_super_secret_jwt_key_123456789

# ========== eSewa Payment Configuration ==========
# Use "sandbox" for testing, "live" for production
ESEWA_ENV=sandbox

# Product code for eSewa (you'll get this from eSewa dashboard)
ESEWA_PRODUCT_CODE=EPAYTEST

# Secret key for signing eSewa payments (you'll get this from eSewa)
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# ========== CORS Configuration ==========
# Frontend URLs that are allowed to access your backend
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ========== Frontend URL (for Payment Callbacks) ==========
# Used when redirecting from eSewa back to frontend
FRONTEND_URL=http://localhost:5173

# ========== File Upload ==========
MAX_FILE_SIZE=5mb
UPLOAD_DIR=uploads/

# ========== Logging ==========
LOG_LEVEL=debug

# ========== API Keys (if using external services) ==========
# Add any additional API keys here